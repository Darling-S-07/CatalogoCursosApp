<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatalogoCursosApp.Views.PerfilPage"
             Title="Perfil">

    <VerticalStackLayout Padding="24,28" Spacing="18">

        <Label Text="Mi Perfil" Style="{StaticResource Headline}" />

        <Border Style="{StaticResource TarjetaCurso}">
            <VerticalStackLayout Spacing="14">

                <HorizontalStackLayout Spacing="8">
                    <Label Text="Nombre:" Style="{StaticResource SubtituloCurso}" />
                    <Label Text="Usuario de prueba" Style="{StaticResource TituloCurso}" FontSize="15" />
                </HorizontalStackLayout>

                <BoxView HeightRequest="1" HorizontalOptions="Fill"
                         Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                <HorizontalStackLayout Spacing="8">
                    <Label Text="Correo:" Style="{StaticResource SubtituloCurso}" />
                    <Label Text="usuario@correo.com" Style="{StaticResource TituloCurso}" FontSize="15" />
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>

</ContentPage>
