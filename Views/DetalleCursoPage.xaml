<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CatalogoCursosApp.Views.DetalleCursoPage"
             Title="Detalle del curso">

    <ScrollView>
        <VerticalStackLayout Padding="24,28" Spacing="18">

            <Label x:Name="LblTitulo" Style="{StaticResource Headline}" />

            <Border Style="{StaticResource TarjetaCurso}">
                <VerticalStackLayout Spacing="14">

                    <Label x:Name="LblDescripcion" Style="{StaticResource SubtituloCurso}" />

                    <BoxView HeightRequest="1" HorizontalOptions="Fill"
                             Color="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />

                    <Label x:Name="LblInstructor" Style="{StaticResource TituloCurso}" FontSize="15" />
                    <Label x:Name="LblDuracion" Style="{StaticResource TituloCurso}" FontSize="15" />
                    <Label x:Name="LblCategoria" Style="{StaticResource EtiquetaCategoria}" />

                </VerticalStackLayout>
            </Border>

            <Button Text="Editar curso"
                    Style="{StaticResource BotonPrimario}"
                    HorizontalOptions="Fill"
                    Clicked="OnEditarClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
